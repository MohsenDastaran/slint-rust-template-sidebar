import { Theme } from "theme.slint";
import { SidebarExample } from "sidebar-example.slint";

export component AppWindow inherits Window {
    title: "Slint Sidebar Example";
    width: 1200px;
    height: 800px;
    background: Theme.background;

    // The example reads `Theme.viewport` for its page padding and the sidebar
    // width, so the window reports its own width there.
    init => {
        Theme.viewport = self.width;
    }

    SidebarExample { }
}
